    "./patches": "./src/patches.js",
    "./scope": "./src/scope.js",
    "./rules": "./src/rules.js",
    "./package.json": "./package.json",
    "./legacy": "./legacy/server.js"
  },
  "files": [
    "src",
    "agents",
    "skills",
    "docs",
    "README.md",
