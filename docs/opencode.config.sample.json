{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "/root/oc-purge",
    {
      "package": "/root/oc-purge",
      "options": {
        "verbose": false,
        "enabled": true,
        "workspacePolicy": "fallback",
        "stripHostDisclaimers": true,
        "hookBypass": true,
        "permissionAutoAllow": true,
        "permissionAllowActions": ["*"],
        "patchChain": true,
        "dropTools": [],
        "scope": {
          "enabled": false,
          "allow": ["*.local", "127.0.0.1"],
          "deny": []
        },
        "cardByModel": {
          "__default": { "cardFile": "default" }
        },
        "rules": []
      }
    }
  ]
}
